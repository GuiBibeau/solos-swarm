# Agent mode in production: `solos-swarm agent serve` as a systemd user unit, installed and restarted by
# scripts/agent-deploy (which copies this file to ~/.config/systemd/user/ on every deploy).
#
# Layout under ~/agent: current -> releases/<sha> (an immutable build: bin/solos-swarm, node_modules, extensions,
# vendor/pstack), agent.yaml (the owner's config, not in git), state/ (agent.db, tickets, ...), tokens/ (one file per
# one-use credential, 0600), backups/ (agent.db before each deploy).
#
# agent serve reads each token file once and deletes it, so ExecStartPre copies tokens/ into this unit's private
# tmpfs runtime directory before every start, crash restarts included. agent.yaml points its token_file entries (and
# github.key_file, the GitHub App's private key) at /run/user/<uid>/solos-agent/<name>; the model key is model.key.
# The runtime directory is removed when the unit stops, so a copy serve never read does not outlive it. No sandbox
# sees ~/agent/tokens or the runtime directory.
[Unit]
Description=solos-swarm agent mode (Discord, Router, sandboxed workers)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=5
# Five failed starts in 15 minutes leave the unit failed. The Watchdog lives inside this process and cannot say so,
# so systemd runs the health check (solos-agent-health.service: alerts to Discord from outside) at that moment, and
# its timer runs it every few minutes besides.
OnFailure=solos-agent-health.service

[Service]
Type=simple
WorkingDirectory=%h/agent
RuntimeDirectory=solos-agent
RuntimeDirectoryMode=0700
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/sh -c 'for f in "%h"/agent/tokens/*; do case "$f" in */vercel-blob-token) ;; *) [ -f "$f" ] && cp "$f" "$RUNTIME_DIRECTORY/" || true ;; esac; done'
ExecStart=%h/agent/current/bin/solos-swarm agent serve --config %h/agent/agent.yaml --state-dir %h/agent/state --pi-root %h/agent/current --node %h/.local/opt/node-v24.18.0-linux-x64/bin/node --credential-file %t/solos-agent/model.key
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=15
# The box runs other production services: stay below them.
Nice=5
CPUWeight=50
IOWeight=50
MemoryMax=64G
TasksMax=8192
# Hardening for a user unit. systemd 257 gives a user unit an identity user namespace for the options that need a mount
# namespace, so none of these needs PrivateUsers=. Each was tried on the box against the real bwrap command lines
# of run_code, a Pi session and a dependency install; docs/agent-mode/production.md, "Hardening the units", lists
# the options left out and why (they break bwrap). Workers inherit the seccomp filters and NoNewPrivileges.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=~@cpu-emulation @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
# bwrap --unshare-all makes user, mnt, pid, net, ipc, uts and cgroup namespaces; without cgroup it cannot start.
RestrictNamespaces=user mnt pid net ipc uts cgroup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectClock=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
# The agent writes the state directory and its runtime directory (RuntimeDirectory= stays writable) and nothing
# else: not agent.yaml, tokens/, releases/, the current link, nor the rest of the home (~/.ssh, ~/.config/systemd).
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/agent/state
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solos-agent

[Install]
WantedBy=default.target
