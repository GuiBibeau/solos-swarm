# Copy to .env.local for local development. On Vercel these are the project's environment variables (README.md).

# The Sign in with Vercel app (Team settings -> Apps). Its callback URL is ${PUBLIC_URL}/auth/callback.
VERCEL_APP_CLIENT_ID=cl_...
VERCEL_APP_CLIENT_SECRET=...

# Encrypts the session cookie. At least 32 characters: `openssl rand -base64 32`. Changing it signs everyone out.
SESSION_SECRET=

# Who may sign in: Vercel account emails, comma separated, compared in lower case.
ALLOWED_EMAILS=g.bibeaulaviolette@gmail.com

# The origin people reach this app at, no trailing slash. http://localhost:3000 locally.
PUBLIC_URL=https://agent.guibibeau.com

# The private Blob store `solos-swarm agent publish` uploads to. Connecting the store to the project on Vercel adds
# this (and BLOB_STORE_ID, which lets the app read with OIDC instead). Needed here only to run against a real store.
BLOB_READ_WRITE_TOKEN=
